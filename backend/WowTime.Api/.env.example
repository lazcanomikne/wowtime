# Copia este archivo como .env (en esta misma carpeta) y llena los valores.
# El archivo .env nunca se sube a git.

# Cadena de conexión a PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5433;Database=wowtime;Username=wowtime;Password=
# Base de datos de pruebas automáticas (se borra y recrea en cada corrida)
ConnectionStrings__Pruebas=Host=localhost;Port=5433;Database=wowtime_test;Username=wowtime;Password=

# Clave para firmar tokens de acceso (mínimo 32 caracteres aleatorios)
Jwt__Clave=
# Opcional: clave separada para firmar enlaces de archivos y QR (por omisión usa Jwt__Clave)
Archivos__SecretoEnlaces=

# Orígenes permitidos por CORS, separados por coma (localhost en pruebas, dominio de Vercel después)
Cors__Origenes=http://localhost:5173

# Carpeta de archivos subidos (fuera de la carpeta pública del sitio)
Archivos__Ruta=C:\wowtime-data\archivos

# Contraseña del usuario admin@wowtime.mx que se crea si la base no tiene usuarios
ADMIN_PASSWORD_INICIAL=

# Opcional: correo saliente. Sin SMTP los correos quedan en Configuración > Correos enviados
Smtp__Host=
Smtp__Puerto=587
Smtp__Usuario=
Smtp__Password=
Smtp__Remitente=
Smtp__Ssl=true

# Opcional: redirigir a HTTPS (true en producción detrás de IIS con certificado)
Https__Redirigir=false
# Opcional: aplicar migraciones al arrancar (true por omisión)
Db__MigrarAlIniciar=true
# Opcional: desactivar el trabajador de tareas programadas (por ejemplo en pruebas)
Tareas__Deshabilitar=false
